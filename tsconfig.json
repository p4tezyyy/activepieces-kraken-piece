{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "work/types",
    "types": [
      "node"
    ],
    "rootDir": "src"
  },
  "include": [
    "src/**/*.ts"
  ]
}